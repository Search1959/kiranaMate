    {
      "name": "orders",
      "description": "Customer Delivery Orders",
      "fields": [
        { "name": "id", "type": "string", "description": "Order ID" },
        { "name": "storeId", "type": "string", "description": "Store ID" }
      ]
    },
    {
      "name": "purchases",
      "description": "Purchase Invoices",
      "fields": [
        { "name": "id", "type": "string", "description": "Purchase ID" },
        { "name": "storeId", "type": "string", "description": "Store ID" }
      ]
    },
    {
      "name": "suppliers",
      "description": "Wholesale Suppliers",
      "fields": [
        { "name": "id", "type": "string", "description": "Supplier ID" },
        { "name": "storeId", "type": "string", "description": "Store ID" }
      ]
    },
    {
      "name": "expenses",
      "description": "Store Expenses",
      "fields": [
        { "name": "id", "type": "string", "description": "Expense ID" },
        { "name": "storeId", "type": "string", "description": "Store ID" }
      ]
    }
